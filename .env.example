# Copia este archivo como .env o application-local.properties y asigna tus credenciales reales.
# NUNCA subas valores reales al repositorio.

PORT=8081
DATABASE_URL=jdbc:postgresql://localhost:5436/prueba1
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Llaves criptograficas (Base64 de 32 bytes para AES-256 / HS256)
AES_LLAVE=CHANGE_ME_BASE64_32_BYTES_AES_KEY
JWT_LLAVE=CHANGE_ME_BASE64_32_BYTES_JWT_KEY
JWT_EXPIRACION_MINUTOS=15
SESION_INACTIVIDAD_MINUTOS=3
CUENTA_SALDO_INICIAL=0.00

# Puntored Servicios H2H - V2 (Preprod/Prod)
PUNTORED_API_URL=https://services.preprodcxr.co/puntored/api/v1
PUNTORED_COMMERCE=CHANGE_ME_COMMERCE_ID
PUNTORED_POS=CHANGE_ME_POINT_OF_SALE
PUNTORED_TERMINAL=CHANGE_ME_TERMINAL
PUNTORED_USERNAME=CHANGE_ME_USERNAME
PUNTORED_PASSWORD=CHANGE_ME_PASSWORD_OR_SHA256
PUNTORED_TX_PASSWORD=CHANGE_ME_TX_PIN

# GestoPago Legacy (si aplica)
GESTOPAGO_URL=https://gestopago.portalventas.net
GESTOPAGO_ID_DISTRIBUIDOR=CHANGE_ME
GESTOPAGO_CODIGO_DISPOSITIVO=CHANGE_ME
GESTOPAGO_PASSWORD=CHANGE_ME
GESTOPAGO_TX_AES_KEY=CHANGE_ME_BASE64_32_BYTES_TX_KEY
GESTOPAGO_TX_AES_IV=CHANGE_ME_BASE64_16_BYTES_IV

# Redis y Correo 2FA
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
PIN_2FA_EXPIRACION_MINUTOS=5
PIN_2FA_MOSTRAR_RESPUESTA=false

# Frontend / CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
